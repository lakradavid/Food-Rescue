# ─────────────────────────────────────────────────────────────
#  FoodRescue – Environment Configuration
#  Copy this file to .env and fill in your actual values.
#  NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string
# For Atlas:    mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# For local:    mongodb://localhost:27017
MONGO_URI=mongodb://localhost:27017

# Name of the database that FoodRescue will use
MONGO_DB_NAME=foodrescue

# Application secret (used for simple session tokens – change to a random string)
APP_SECRET=change_this_to_a_random_secret_string

# Set to "development" or "production"
APP_ENV=development
